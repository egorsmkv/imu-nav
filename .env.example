# Copy to .env at the repository root. Never commit .env.
# Generate an URL-safe password with: openssl rand -hex 32
POSTGRES_PASSWORD=REPLACE_WITH_RANDOM_HEX
# Public HTTPS domain used by both the server and Caddy (no trailing slash or path).
CELLS_PUBLIC_URL=https://cells.example.org
CELLS_SMTP_HOST=smtp.example.org
CELLS_SMTP_USERNAME=imu-nav@example.org
CELLS_SMTP_PASSWORD=REPLACE_WITH_SMTP_PASSWORD
CELLS_SMTP_FROM=imu-nav@example.org
# Replace every field with your operator's actual details. Avoid leaving example values.
CELLS_PRIVACY_VERSION=2026-10-06-air-alerts
CELLS_PRIVACY_CONTROLLER=CHANGE_ME
CELLS_PRIVACY_CONTACT=CHANGE_ME
CELLS_PRIVACY_RIGHTS_CONTACT=CHANGE_ME
CELLS_PRIVACY_REGION=CHANGE_ME
CELLS_PRIVACY_RECIPIENTS=CHANGE_ME
CELLS_PRIVACY_TRANSFERS=CHANGE_ME
CELLS_PRIVACY_ACCOUNT_BASIS=CHANGE_ME
CELLS_PRIVACY_SECURITY_BASIS=CHANGE_ME

# Optional. Use a dedicated UkraineAlarm API key and a random 32+ character secret.
# CELLS_AIR_ALERTS_API_KEY=REPLACE_WITH_PROVIDER_KEY
# CELLS_AIR_ALERTS_WEBHOOK_SECRET=REPLACE_WITH_RANDOM_ALPHANUMERIC_SECRET
